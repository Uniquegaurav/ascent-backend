# Copy to .env and adjust.
# ENV must be "dev" for local work; anything else (including unset) is treated
# as prod and enforces Validate(): real JWT_SECRET, scoped OTP backdoor, etc.
ENV=dev
PORT=8080
DATABASE_URL=postgres://summit:summit@localhost:5432/summit?sslmode=disable
JWT_SECRET=change-me-in-prod-please-32-bytes-min
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=2160h

# Dev backdoor OTP: in ENV=dev this fixed code always verifies (real codes are
# also logged to stdout). In prod it only verifies for OTP_REVIEW_PHONE — use
# that for app-store review accounts, or leave both empty to disable.
OTP_DEV_CODE=000000
OTP_REVIEW_PHONE=

# OTP delivery: "log" prints codes to stdout (dev), "msg91" sends real SMS.
# MSG91 template must contain the ##OTP## variable (DLT-approved).
SMS_PROVIDER=log
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Discovery. Leave blank to use built-in sample data.
GOOGLE_PLACES_KEY=
