# Copy to .env and adjust.
ENV=dev
PORT=8080
DATABASE_URL=postgres://summit:summit@localhost:5432/summit?sslmode=disable
JWT_SECRET=change-me-in-prod-please-32-bytes-min
ACCESS_TOKEN_TTL=720h
# In dev, this fixed code always verifies (OTP is also logged to stdout).
OTP_DEV_CODE=000000
# Discovery (added in a later slice). Leave blank to use built-in sample data.
GOOGLE_PLACES_KEY=
